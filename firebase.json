{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["pnpm --filter summit-functions run build"],
      "ignore": [
        "node_modules",
        ".git",
        "src",
        "build.mjs",
        "*.ts",
        ".env"
      ]
    }
  ],
  "hosting": {
    "site": "learning-summit---vincent",
    "public": "apps/summit/dist/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],


    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "dataconnect": {
    "source": "dataconnect"
  }
}
